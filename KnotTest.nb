Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minDist", "=", "0.05"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxIterations", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxWiggleStep", "=", "0.01"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wiggleX", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.005"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wiggleY", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.005"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggleZ", "=", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"WienerProcess", "[", 
         RowBox[{"0", ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0.005"}], "}"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"largestVec", "[", "v_", "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Norm", "[", "v", "]"}], ">", "maxWiggleStep"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"maxWiggleStep", "/", 
         RowBox[{"Norm", "[", "v", "]"}]}], ")"}], "*", "v"}], ",", "v"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggle", "=", 
    RowBox[{"Accumulate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"largestVec", "[", 
          RowBox[{"0.01", "*", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"wiggleX", "[", 
              RowBox[{"[", "t", "]"}], "]"}], ",", 
             RowBox[{"wiggleY", "[", 
              RowBox[{"[", "t", "]"}], "]"}], ",", 
             RowBox[{"wiggleZ", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "100"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dna", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"animation", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"frame", "=", 
           RowBox[{"dna", "+", 
            RowBox[{"wiggle", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}], ",", "i", ",", "j", ",", 
          "dir", ",", "dist"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"dist", "=", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{"frame", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"frame", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"dist", "<", "minDist"}], "&&", 
                 RowBox[{"dist", ">", "0"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"dir", "=", 
                  RowBox[{"Normalize", "[", 
                   RowBox[{
                    RowBox[{"frame", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"frame", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"frame", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "+=", 
                  RowBox[{"0.5", "*", 
                   RowBox[{"(", 
                    RowBox[{"minDist", "-", "dist"}], ")"}], "*", "dir"}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"frame", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "-=", 
                  RowBox[{"0.5", "*", 
                   RowBox[{"(", 
                    RowBox[{"minDist", "-", "dist"}], ")"}], "*", "dir"}]}], 
                 ";"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Table", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"dist", "=", 
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{"frame", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                   RowBox[{"frame", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"dist", "<", "minDist"}], "&&", 
                   RowBox[{"dist", ">", "0"}]}], ",", 
                  RowBox[{
                   RowBox[{"dir", "=", 
                    RowBox[{"Normalize", "[", 
                    RowBox[{
                    RowBox[{"frame", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"frame", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"frame", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+=", 
                    RowBox[{"0.5", "*", 
                    RowBox[{"(", 
                    RowBox[{"minDist", "-", "dist"}], ")"}], "*", "dir"}]}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"frame", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-=", 
                    RowBox[{"0.5", "*", 
                    RowBox[{"(", 
                    RowBox[{"minDist", "-", "dist"}], ")"}], "*", "dir"}]}], 
                   ";"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", "maxIterations", "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
