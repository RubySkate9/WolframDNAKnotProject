Cell[BoxData[{
 RowBox[{"n", "=", "30"}], "\n", 
 RowBox[{"dna", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"-", "1.1"}], "}"}], "]"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}]}], "]"}], ",", 
    "30"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wiggle", "=", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "#", "]"}], "&"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "100"}], "}"}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"animation", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", 
          RowBox[{"Tube", "[", 
           RowBox[{"AnglePath3D", "[", 
            RowBox[{"dna", "+", 
             RowBox[{"wiggle", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", " ", 
        RowBox[{"Boxed", "->", "False"}]}], "]"}], ",", 
