        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"dist", "=", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"coords", "[", 
