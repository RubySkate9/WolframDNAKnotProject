     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wiggleY", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggleZ", "=", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"WienerProcess", "[", 
         RowBox[{"0", ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"largestVec", "[", "v_", "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Norm", "[", "v", "]"}], ">", "maxWiggleStep"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"maxWiggleStep", "/", 
         RowBox[{"Norm", "[", "v", "]"}]}], ")"}], "*", "v"}], ",", "v"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggle", "=", 
    RowBox[{"Accumulate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"largestVec", "[", 
          RowBox[{"0.01", "*", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"wiggleX", "[", 
              RowBox[{"[", "t", "]"}], "]"}], ",", 
             RowBox[{"wiggleY", "[", 
              RowBox[{"[", "t", "]"}], "]"}], ",", 
             RowBox[{"wiggleZ", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dna", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
