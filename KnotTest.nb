Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "50"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"wiggleX", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.005"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wiggleY", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.005"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " ", ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggleZ", "=", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"WienerProcess", "[", 
         RowBox[{"0", ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0.005"}], "}"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggle", "=", 
    RowBox[{"Accumulate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"0.01", "*", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"wiggleX", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", 
            RowBox[{"wiggleY", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", 
            RowBox[{"wiggleZ", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "100"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dna", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}]}], "]"}], ",",
       "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"animation", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", 
          RowBox[{"Tube", "[", 
           RowBox[{"AnglePath3D", "[", 
            RowBox[{"dna", "+", 
             RowBox[{"wiggle", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Boxed", "->", "False"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "100"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{"animation", ",", 
   RowBox[{"DefaultDuration", "->", "10"}]}], "]"}]}], "Input",
