Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"timesteps", "=", "100"}], ";"}], " ", 
  RowBox[{"(*", "frames", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p1", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"start", " ", "point"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"end", " ", "point"}], "*)"}], "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linPositions", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "/", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"p2", "-", "p1"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "making", " ", "the", " ", "line", " ", "segments", " ", "in", " ", 
     "between"}], " ", "-", " ", "coordinates"}], "*)"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"genInternalWiggle", "[", "steps_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"wig", ",", "smooth"}], "}"}], ",", " ", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"wig", "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", "0.05"}], "]"}], ",", " ", 
           RowBox[{"{", "steps", "}"}]}], "]"}]}], ";"}], " ", 
       RowBox[{"(*", 
        RowBox[{
        "generate", " ", "random", " ", "coords", " ", "from", " ", "normal", 
         " ", "dist", " ", "for", " ", "the", " ", "100", " ", "frames", " ", 
         "for", " ", "ONE", " ", "point"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"wig", "=", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"RandomFunction", "[", 
            RowBox[{
             RowBox[{"WienerProcess", "[", 
              RowBox[{"0", ",", "1"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], "*)"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"smooth", "=", 
        RowBox[{"GaussianFilter", "[", 
         RowBox[{"wig", ",", " ", "3"}], "]"}]}], ";"}], " ", 
      RowBox[{"(*", 
       RowBox[{"smooth", " ", "it", " ", "out"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"smooth", "=", 
        RowBox[{"WienerFilter", "[", 
         RowBox[{"wig", ",", " ", "10"}], "]"}]}], "*)"}], ";", 
      "\[IndentingNewLine]", "smooth"}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"wigX", ",", "wigY", ",", "wigZ"}], "}"}], ",", " ", 
        RowBox[{"(*", 
         RowBox[{
         "make", " ", "coords", " ", "in", " ", "all", " ", "3", " ", "axes", 
          " ", "for", " ", "each", " ", "segment"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wigX", "=", 
          RowBox[{"genInternalWiggle", "[", "timesteps", "]"}]}], ";", " ", 
         "\[IndentingNewLine]", 
         RowBox[{"wigY", "=", 
          RowBox[{"genInternalWiggle", "[", "timesteps", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"wigZ", "=", 
          RowBox[{"genInternalWiggle", "[", "timesteps", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"wigX", ",", "wigY", ",", "wigZ"}], "}"}], "]"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "p1", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"linPositions", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
