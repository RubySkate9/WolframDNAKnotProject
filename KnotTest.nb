                  RowBox[{"coords", "[", 
                   RowBox[{"[", "t", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"dist", "<", "minDist"}], "&&", 
                 RowBox[{"dist", ">", "0"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"dir", "=", 
                  RowBox[{"Normalize", "[", 
