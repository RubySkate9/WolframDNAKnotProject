Cell[BoxData[{
 RowBox[{
  RowBox[{"numSteps", "=", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deltaT", "=", "0.05"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"trefoilKnot2", "[", "n_", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", 
