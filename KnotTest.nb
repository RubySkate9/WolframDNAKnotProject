Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"geo", "=", 
   RowBox[{"RandomFunction", "[", 
    RowBox[{
     RowBox[{"GeometricBrownianMotionProcess", "[", 
      RowBox[{"0", ",", "0.1", ",", "2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Normal", "[", "geo", "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"testing", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " ", "\n"}], "\[IndentingNewLine]", 
 RowBox[{"n", "=", "30"}], "\n", 
 RowBox[{"dna", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"-", "1.1"}], "}"}], "]"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}]}], "]"}], ",", 
    "30"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wiggle", "=", 
   RowBox[{"Accumulate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"0.02", "*", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "3"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "100"}], "}"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"animation", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", 
          RowBox[{"Tube", "[", 
           RowBox[{"AnglePath3D", "[", 
            RowBox[{"dna", "+", 
             RowBox[{"wiggle", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", " ", 
        RowBox[{"Boxed", "->", "False"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{"animation", ",", " ", 
   RowBox[{"DefaultDuration", "->", "10"}]}], "]"}], "\n"}], "Input",
