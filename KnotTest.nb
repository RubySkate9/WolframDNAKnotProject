           RowBox[{"wiggleZ", "[", 
            RowBox[{"[", "t", "]"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"{", "internal", "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "timesteps"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
