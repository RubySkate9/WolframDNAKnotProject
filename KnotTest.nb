Cell["\<\
Algorithm for maintaining lengths:
Start at the next point from the fixed starting point
Calculate the line between the neighboring points next to it (to the left and \
to the right)
Find the disk with center on the line but perpendicular to it, and radius of \
the length from the original point to that line
Randomly choose a point on that disk\[CloseCurlyQuote]s circumference
Update the coordinate
Move onto the next point
Calculate the line...\
\>", "Text",
 CellChangeTimes->{{3.960289466783621*^9, 
  3.960289583441782*^9}},ExpressionUUID->"63ad8ee1-d9b6-4834-bba6-\
a11903c4028b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"timesteps", "=", "100"}], ";"}], " ", 
  RowBox[{"(*", "frames", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p1", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"start", " ", "point"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"end", " ", "point"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basePoints", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"p1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"p2", "-", "p1"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"linPositions", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"basePoints", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", "i", "]"}], ",", "0.01", ",", 
           RowBox[{"-", "0.01"}]}], "]"}], ",", "0"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "making", " ", "the", " ", "line", " ", "segments", " ", "in", " ", 
     "between"}], " ", "-", " ", "coordinates"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics3D", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Red", ",", " ", 
     RowBox[{"Sphere", "[", 
      RowBox[{"p1", ",", "0.03"}], "]"}], ",", 
     RowBox[{"Sphere", "[", 
      RowBox[{"p2", ",", "0.03"}], "]"}], ",", " ", "Blue", ",", 
     RowBox[{"Tube", "[", "linPositions", "]"}]}], "}"}], ",", " ", 
   RowBox[{"ImageSize", "->", "Small"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"getCoord", "[", "i_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "prev", ",", "curr", ",", "next", ",", "neighborVec", ",", "mid", ",", 
       "PM", ",", "radius", ",", "u", ",", "v", ",", "disk"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"prev", "=", 
       RowBox[{"linPositions", "[", 
        RowBox[{"[", 
         RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"curr", "=", 
       RowBox[{"linPositions", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"next", "=", 
       RowBox[{"linPositions", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"neighborVec", "=", 
       RowBox[{"next", "-", "prev"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mid", "=", 
       RowBox[{"Midpoint", "[", 
        RowBox[{"{", 
         RowBox[{"prev", ",", " ", "next"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PM", "=", 
       RowBox[{"curr", "-", "mid"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"radius", "=", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{"PM", ",", "neighborVec"}], "]"}], "]"}], "/", 
        RowBox[{"Norm", "[", "neighborVec", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"u", "=", 
       RowBox[{"Normalize", "[", "PM", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"v", "=", 
       RowBox[{"Normalize", "[", 
        RowBox[{"Cross", "[", 
         RowBox[{"neighborVec", ",", "u"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"disk", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"mid", "+", 
          RowBox[{"radius", " ", 
