Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "30"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"total", " ", "number", " ", "of", " ", "points"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"timesteps", "=", "100"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Generate", " ", "base", " ", "points", " ", "from", " ", "p1", " ", "to", 
    " ", "p2"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basePoints", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"p1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"p2", "-", "p1"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"linPositions", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"basePoints", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", "i", "]"}], ",", "0.01", ",", 
           RowBox[{"-", "0.01"}]}], "]"}], ",", "0"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Indices", " ", "for", " ", "trefoil", " ", "segment"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"knotStart", "=", 
   RowBox[{"Round", "[", 
    RowBox[{"n", "/", "3"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"knotEnd", "=", 
   RowBox[{"Round", "[", 
    RowBox[{"2", " ", 
     RowBox[{"n", "/", "3"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"knotLength", "=", 
    RowBox[{"knotEnd", "-", "knotStart", "+", "1"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Generate", " ", "a", " ", "trefoil", " ", "knot"}], ",", 
    RowBox[{
    "scaled", " ", "and", " ", "centered", " ", "to", " ", "fit", " ", "into",
      " ", "segment"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"trefoilKnot", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"3", " ", "t"}], "]"}]}], ")"}], " ", 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"3", " ", "t"}], "]"}]}], ")"}], " ", 
      RowBox[{"Sin", "[", "t", "]"}]}], ",", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", " ", "t"}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rawTrefoil", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"trefoilKnot", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
          RowBox[{"knotLength", "-", "1"}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"knotLength", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Scale", " ", "and", " ", "shift", " ", "knot", " ", "to", " ", "fit", " ",
     "between", " ", 
    RowBox[{"linPositions", "[", 
     RowBox[{"[", "knotStart", "]"}], "]"}], " ", "and", " ", 
    RowBox[{"linPositions", "[", 
     RowBox[{"[", "knotEnd", "]"}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"knotVec", "=", 
   RowBox[{
    RowBox[{"linPositions", "[", 
     RowBox[{"[", "knotEnd", "]"}], "]"}], "-", 
    RowBox[{"linPositions", "[", 
     RowBox[{"[", "knotStart", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"knotCenter", "=", 
   RowBox[{"Mean", "[", "rawTrefoil", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scaledKnot", "=", 
    RowBox[{"Normalize", "/@", 
     RowBox[{"(", 
      RowBox[{"rawTrefoil", "-", "knotCenter"}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"unit", " ", "directions"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scaledKnot", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0.1", "*", "#"}], "&"}], ")"}], "/@", "scaledKnot"}]}], ";"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{"scale", " ", "to", " ", "small", " ", "segment", " ", "size"}], 
   "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trefoilSegment", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"linPositions", "[", 
        RowBox[{"[", "knotStart", "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "/", 
          RowBox[{"(", 
           RowBox[{"knotLength", "-", "1"}], ")"}]}], ")"}], " ", "knotVec"}],
        "+", 
       RowBox[{"scaledKnot", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "knotLength"}], "}"}]}], "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Now", " ", "reassemble", " ", "the", " ", "full", " ", "chain"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linPositions", "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"linPositions", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", 
         RowBox[{"knotStart", "-", "1"}]}], "]"}], "]"}], ",", 
      "trefoilSegment", ",", 
      RowBox[{"linPositions", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"knotEnd", "+", "1"}], ";;"}], "]"}], "]"}]}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Movement", " ", "function"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getCoord", "[", "i_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "prev", ",", "curr", ",", "next", ",", "neighborVec", ",", "mid", ",", 
        "PM", ",", "radius", ",", "u", ",", "v", ",", "disk"}], "}"}], ",", 
      RowBox[{
       RowBox[{"prev", "=", 
        RowBox[{"linPositions", "[", 
         RowBox[{"[", 
          RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"curr", "=", 
        RowBox[{"linPositions", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"next", "=", 
        RowBox[{"linPositions", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"neighborVec", "=", 
        RowBox[{"next", "-", "prev"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mid", "=", 
        RowBox[{"Midpoint", "[", 
         RowBox[{"{", 
          RowBox[{"prev", ",", "next"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"PM", "=", 
        RowBox[{"curr", "-", "mid"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"radius", "=", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{"PM", ",", "neighborVec"}], "]"}], "]"}], "/", 
         RowBox[{"Norm", "[", "neighborVec", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"Normalize", "[", "PM", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"v", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{"neighborVec", ",", "u"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"disk", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"mid", "+", 
           RowBox[{"radius", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "u"}], "+", 
           RowBox[{"radius", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", "v"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", "0", ",", 
            RowBox[{"2", " ", "Pi"}], ",", 
            RowBox[{"Pi", "/", "300"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"linPositions", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "=", 
        RowBox[{"RandomChoice", "[", "disk", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"linPositions", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Time", " ", "evolution"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "p1", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"getCoord", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", "p2", "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "timesteps"}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Animate", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"animation", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Sphere", "[", 
           RowBox[{"p1", ",", "0.03"}], "]"}], ",", 
          RowBox[{"Sphere", "[", 
           RowBox[{"p2", ",", "0.03"}], "]"}], ",", "Blue", ",", 
          RowBox[{"Tube", "[", 
           RowBox[{
            RowBox[{"coords", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", "0.02"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Boxed", "->", "True"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "timesteps"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{"animation", ",", 
   RowBox[{"DefaultDuration", "->", "5"}]}], "]"}], "\n"}], "Input",
