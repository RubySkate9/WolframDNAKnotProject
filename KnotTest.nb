Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "30"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"wiggleX", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"GeometricBrownianMotionProcess", "[", 
        RowBox[{"0", ",", "0.1", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wiggleY", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"GeometricBrownianMotionProcess", "[", 
        RowBox[{"0", ",", "0.1", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " "}], "\n", 
 RowBox[{
  RowBox[{"wiggleZ", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"GeometricBrownianMotionProcess", "[", 
        RowBox[{"0", ",", "0.1", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Length", "[", "wiggleX", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggle", "=", 
    RowBox[{"Accumulate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0.02", "*", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"wiggleX", "[", 
              RowBox[{"[", "t", "]"}], "]"}], ",", 
             RowBox[{"wiggleY", "[", 
              RowBox[{"[", "t", "]"}], "]"}], ",", 
             RowBox[{"wiggleZ", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "}"}]}], "+", 
          RowBox[{"0.05", "*", 
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "3"}], "]"}]}]}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "100"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dna", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{"-", "1.1"}], "}"}], "]"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "}"}]}], "]"}], ",", 
     "30"}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"animation", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", 
          RowBox[{"Tube", "[", 
           RowBox[{"AnglePath3D", "[", 
            RowBox[{"dna", "+", 
             RowBox[{"wiggle", "[", 
              RowBox[{"[", "t", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Boxed", "->", "False"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "100"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{"animation", ",", 
   RowBox[{"DefaultDuration", "->", "10"}]}], "]"}]}], "Input",
