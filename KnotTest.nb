      "numSteps"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"deltaS", "=", 
   RowBox[{"Differences", "[", "positions", "]"}]}], ";"}], "\n", 
