Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxWiggleStep", "=", "0.01"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wiggleX", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wiggleY", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"RandomFunction", "[", 
      RowBox[{
       RowBox[{"WienerProcess", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggleZ", "=", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"WienerProcess", "[", 
         RowBox[{"0", ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"internal", "=", "8"}], ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linPositions", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "/", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"p2", "-", "p1"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timesteps", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wiggles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"0.5", "*", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"wiggleX", "[", 
